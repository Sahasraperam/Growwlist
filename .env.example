# ── Supabase Configuration ──────────────────────────────────────────────────
# Server-only environment variables (not exposed to browser bundle)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Service-role key — BYPASSES RLS (SERVER-ONLY, NEVER COMMIT REAL KEY)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-side injected environment variables (VITE_ prefix)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ── Market Data Configuration ──────────────────────────────────────────────
# How often frontend queries refresh market data (in milliseconds)
MARKET_DATA_INTERVAL_MS=180000

# Enable mock market data generator for testing without live exchange feeds (true/false)
USE_MOCK_MARKET_DATA=false
